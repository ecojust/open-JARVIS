# Copy to .env. Without a key, JARVIS runs in limited command demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For an OpenAI-compatible provider, change all three settings above.
# For a local model server that requires no key, use a placeholder key.

# Optional: Brave Search API key. Otherwise uses DuckDuckGo public HTML search.
BRAVE_API_KEY=

# Optional custom paths. Empty uses the OS user application-data directory.
# Source .env relative paths resolve against the project directory.
JARVIS_WORKSPACE=
# JARVIS_DATA_DIR=/your/private/app-data
JARVIS_MAX_TOOL_ROUNDS=8
# Microsoft Agent Framework coordinates the specialist agents locally.
JARVIS_ORCHESTRATOR=maf
JARVIS_MAX_MODEL_CALLS=12
JARVIS_MAX_TOOL_CALLS=24
JARVIS_TASK_TIMEOUT=300
JARVIS_MAX_PENDING_TASKS=3

# Desktop client: local continuous speech recognition using sherpa-onnx + SenseVoice.
# Download first with: python -m jarvis.download_model
JARVIS_STT_MODEL_DIR=
JARVIS_STT_THREADS=2
# Local Kokoro v1.1 TTS. Download with: python -m jarvis.download_tts_model
JARVIS_TTS_MODEL_DIR=
# Official Chinese female voice zf_001; valid Chinese voices: 3-102.
JARVIS_TTS_SPEAKER=3
JARVIS_TTS_SPEED=1.0
JARVIS_TTS_THREADS=2
JARVIS_TTS_IDLE_SECONDS=120
# Wake once for continuous conversation until user pause; empty disables wake matching.
JARVIS_WAKE_WORD=贾维斯
# Optional sounddevice input device index; empty uses system default microphone.
JARVIS_MIC_DEVICE=
# Optional output device index; empty uses the system default speaker.
JARVIS_SPEAKER_DEVICE=
JARVIS_DESKTOP_PORT=8765
UI_SPEECH_ENABLED=true
# Legacy key retained for upgrades; controls automatic maximized results (not fullscreen).
UI_AUTO_FULLSCREEN=true
